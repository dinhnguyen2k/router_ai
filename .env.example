# --- Router endpoint ---------------------------------------------------------
# Where the router listens. This is the address a CLI is pointed at.
ROUTER_HOST="127.0.0.1"
ROUTER_PORT="8787"

# The URL printed in setup snippets. Override when reaching the router through
# a tunnel or a different hostname than it binds to.
# ROUTER_PUBLIC_URL="http://127.0.0.1:8787"

# --- Local credential --------------------------------------------------------
# The token inbound CLI clients must present. Generated and stored under
# ROUTER_DATA_DIR on first run if left unset.
# ROUTER_LOCAL_TOKEN="rtr-..."

# --- At-rest encryption ------------------------------------------------------
# Key used to encrypt stored provider API keys (AES-256-GCM). Generated and
# stored under ROUTER_DATA_DIR on first run if left unset.
# Changing this makes existing stored credentials unreadable; they will show as
# disabled in the dashboard and must be re-entered.
# ROUTER_SECRET="a-long-random-string"

# --- Storage -----------------------------------------------------------------
# Directory holding router.db, secret.key and local-token. Relative to project root.
ROUTER_DATA_DIR=".router-data"

# --- Logging -----------------------------------------------------------------
# debug | info | warn | error
ROUTER_LOG_LEVEL="info"
# Force JSON log lines even on a TTY.
# ROUTER_LOG_JSON="true"

# --- Dashboard ---------------------------------------------------------------
# Origin allowed through CORS while running `npm run dev`.
ROUTER_DEV_ORIGIN="http://localhost:3000"
